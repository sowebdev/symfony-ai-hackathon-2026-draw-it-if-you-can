{# The walrus referee, beside Olaf in the same polar world: he judges every answer the same way, whoever gives it.
   At rest he is pale and still; the `referee` controller wakes him on a warm or an accepted verdict (app.css,
   .referee). `found` (default false): the round is found, he stays on « C'est juste ! ». The panel around
   him is already aria-live: no second one here. #}
{% set found = found|default(false) %}
{% set chair = chair|default(false) %}
<div class="referee{{ chair ? ' on-chair' }}{{ found ? ' is-speaking is-accepted' }}" data-controller="referee" data-action="referee:verdict@window->referee#hear">
    <svg class="referee-walrus" viewBox="0 0 140 120" width="64" height="55" fill="none" stroke="#2b2b2b" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M20 95 C10 50 40 20 70 20 C100 20 130 50 120 95 Z" fill="#d9b99b"/>
        <circle cx="52" cy="50" r="5" fill="#2b2b2b"/><circle cx="88" cy="50" r="5" fill="#2b2b2b"/>
        <ellipse cx="58" cy="68" rx="14" ry="10" fill="#e8c9a8"/><ellipse cx="82" cy="68" rx="14" ry="10" fill="#e8c9a8"/>
        <path d="M58 76 L54 108" stroke-width="5" stroke="#fffdf6"/><path d="M58 76 L54 108"/>
        <path d="M82 76 L86 108" stroke-width="5" stroke="#fffdf6"/><path d="M82 76 L86 108"/>
        <rect x="62" y="74" width="18" height="10" rx="3" fill="#ffd43b"/>
        <path d="M30 32 h80" stroke-width="3"/><rect x="40" y="18" width="60" height="14" rx="3" fill="#2b2b2b"/>
    </svg>
    {% if chair %}<svg class="referee-chair" viewBox="0 0 120 150" width="110" height="137" fill="none" stroke="#2b2b2b" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M30 20 v120 M90 20 v120 M30 70 h60 M30 110 h60 M20 140 h20 M80 140 h20"/><rect x="18" y="6" width="84" height="16" rx="3" fill="#fff4bf"/></svg>{% endif %}
    <p class="referee-bubble referee-warm" data-referee-target="warm" hidden>{{ 'referee.warm'|trans }}</p>
    <p class="referee-bubble referee-accepted" data-referee-target="accepted" {{ found ? '' : 'hidden' }}>{{ 'referee.accepted'|trans }}</p>
</div>
