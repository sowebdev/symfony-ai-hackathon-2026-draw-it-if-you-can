{# A small sketch of who plays in a mode: the player (round head), the AI of the game (square head,
   antenna), an agent connected over MCP (a screen for a head, a cable, in orange). #}
{% set ink = 'fill="none" stroke="#2b2b2b" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"' %}
{% set pen = 'fill="none" stroke="#e8590c" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"' %}
{% macro player(x, ink) %}<g transform="translate({{ x }} 0)" {{ ink|raw }}><circle cx="0" cy="-30" r="10"/><path d="M0 -20 L0 6 M0 6 L-9 26 M0 6 L9 26 M0 -12 L-13 -1 M0 -12 L13 -2"/></g>{% endmacro %}
{% macro ai(x, ink) %}<g transform="translate({{ x }} 0)" {{ ink|raw }}><rect x="-11" y="-41" width="22" height="20" rx="3"/><circle cx="0" cy="-51" r="2.5"/><path d="M0 -41 L0 -48.5 M-4 -33 L-4 -32 M4 -33 L4 -32 M0 -21 L0 6 M0 6 L-9 26 M0 6 L9 26 M0 -12 L-13 -2 M0 -12 L13 -1"/></g>{% endmacro %}
{% macro agent(x, pen) %}<g transform="translate({{ x }} 0)" {{ pen|raw }}><rect x="-13" y="-42" width="26" height="20" rx="2"/><path d="M-6 -34 L-2 -30 L-6 -26 M2 -26 L7 -26 M0 -22 L0 6 M0 6 L-9 26 M0 6 L9 26 M0 -12 L-13 -2 M0 -12 L13 -2 M13 -32 C24 -32 22 -14 30 -12"/></g>{% endmacro %}
<svg width="150" height="90" viewBox="-75 -60 150 90" aria-hidden="true">
    {% if mode == 'solo' %}
        {{ _self.player(-28, ink) }}{{ _self.ai(28, ink) }}
        <path {{ pen|raw }} d="M-8 -8 C-4 -16 4 -16 8 -8 C4 -2 0 2 0 2 C0 2 -4 -2 -8 -8 Z"/>
    {% elseif mode == 'copilot' %}
        {{ _self.player(-22, ink) }}{{ _self.agent(30, pen) }}
        <path {{ pen|raw }} d="M-6 -50 C-6 -58 10 -58 10 -50 C10 -44 4 -42 2 -42 L-2 -36 L-1 -42 C-4 -43 -6 -46 -6 -50 Z"/>
    {% else %}
        {{ _self.player(-55, ink) }}{{ _self.ai(-25, ink) }}
        <path {{ pen|raw }} d="M8 -30 L2 -14 L10 -14 L4 2"/>
        {{ _self.agent(38, pen) }}
    {% endif %}
</svg>
