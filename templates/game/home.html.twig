{% extends 'base.html.twig' %}

{% block body %}
    <main class="home">
        <nav class="languages" aria-label="{{ 'label.language'|trans }}">
            {% for language in languages %}
                <a href="{{ path('home', {_locale: language.value}) }}" hreflang="{{ language.value }}" lang="{{ language.value }}"
                   {{ language.value == app.locale ? 'aria-current="page"' }}>{{ language.label }}</a>
            {% endfor %}
        </nav>
        <h1>Draw It If You Can</h1>
        <p>{{ 'tagline'|trans }}</p>
        {% if error %}
            <p class="error" role="alert">{{ error|trans }}</p>
        {% endif %}
        <form method="post" action="{{ path('game_create') }}" class="new-game">
            <label>
                {{ 'label.theme'|trans }}
                <select name="theme">
                    {% for theme in themes %}
                        <option value="{{ theme.value }}">{{ theme|trans }}</option>
                    {% endfor %}
                </select>
            </label>
            <p class="who-starts">{{ 'label.who_starts'|trans }}</p>
            <div class="modes">
                <button type="submit" name="drawnBy" value="ai">{{ 'action.ai_draws'|trans }}</button>
                <button type="submit" name="drawnBy" value="player">{{ 'action.player_draws'|trans }}</button>
            </div>
        </form>
    </main>
{% endblock %}
