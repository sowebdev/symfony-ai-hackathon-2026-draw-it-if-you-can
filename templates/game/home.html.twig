{% extends 'base.html.twig' %}

{% block body %}
    <main class="home">
        <nav class="languages" aria-label="{{ 'label.language'|trans }}">
            <details>
                <summary lang="{{ app.locale }}">{% for language in languages %}{{ language.value == app.locale ? language.label }}{% endfor %}</summary>
                <ul>
                    {% for language in languages %}
                        <li>
                            <a href="{{ path('home', {_locale: language.value}) }}" hreflang="{{ language.value }}" lang="{{ language.value }}"
                               {{ language.value == app.locale ? 'aria-current="page"' }}>{{ language.label }}</a>
                        </li>
                    {% endfor %}
                </ul>
            </details>
        </nav>
        <h1>Draw It If You Can</h1>
        <p>{{ 'tagline'|trans }}</p>
        {% if error %}
            <p class="error" role="alert">{{ error|trans }}</p>
        {% endif %}
        <form method="post" action="{{ path('game_create') }}" class="new-game">
            <fieldset class="game-mode">
                <legend>{{ 'label.mode'|trans }}</legend>
                <div class="mode-cards">
                    {% for mode in ['solo', 'copilot', 'duel'] %}
                        <label class="mode-card mode-{{ mode }}">
                            <input type="radio" name="mode" value="{{ mode }}" {{ loop.first ? 'checked' }}>
                            {{ include('game/_mode_sketch.html.twig') }}
                            <strong>{{ ('mode.' ~ mode)|trans }}</strong>
                            <small>{{ ('mode.' ~ mode ~ '_hint')|trans }}</small>
                            {% if mode != 'solo' %}<span class="mode-mcp">{{ 'mode.via_mcp'|trans }}</span>{% endif %}
                        </label>
                    {% endfor %}
                </div>
            </fieldset>
            <p class="game-settings">
                {{- 'settings.line_rounds'|trans({'%count%': settings.rounds, '%seconds%': settings.roundSeconds}) }} ·
                {{ ('settings.line_turns_' ~ settings.turns.value)|trans }} ·
                {{ settings.allThemes
                    ? 'settings.line_themes_all'|trans({'%count%': theme_count})
                    : 'settings.line_themes_some'|trans({'%count%': settings.themes|length, '%total%': theme_count}) }} ·
                <a href="{{ path('settings') }}">{{ 'settings.change'|trans }}</a>
            </p>
            <div class="modes">
                <button type="submit">{{ 'action.start_game'|trans }}</button>
            </div>
        </form>
        {% if has_model %}
            {{ include('game/_health.html.twig') }}
        {% else %}
            <section class="health no-model">
                <p>{{ 'help.no_model'|trans }}</p>
                <a class="button" href="{{ path('models') }}">{{ 'action.choose_model'|trans }}</a>
            </section>
        {% endif %}
        <p class="configure-model"><a href="{{ path('models') }}">{{ 'action.configure_model'|trans }}</a></p>
    </main>
{% endblock %}
