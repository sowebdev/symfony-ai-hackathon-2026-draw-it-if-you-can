{% extends 'base.html.twig' %}

{% block title %}Draw It If You Can{% endblock %}

{% block body %}
    <main class="home">
        <h1>Draw It If You Can</h1>
        <p>You draw, the AI guesses.</p>
        {% if error %}
            <p class="error" role="alert">{{ error }}</p>
        {% endif %}
        <form method="post" action="{{ path('game_create') }}" class="new-game">
            <label>
                Theme
                <select name="theme">
                    {% for theme in themes %}
                        <option value="{{ theme.value }}">{{ theme.label }}</option>
                    {% endfor %}
                </select>
            </label>
            <label>
                Language
                <select name="language">
                    {% for language in languages %}
                        <option value="{{ language.value }}">{{ language.label }}</option>
                    {% endfor %}
                </select>
            </label>
            <button type="submit">New game</button>
        </form>
    </main>
{% endblock %}
