{% extends 'base.html.twig' %}

{# Before a game with an agent connected over MCP, copilot or rival: how to connect it, and whether it is there. #}
{% set duel = game.duel %}
{% set prompt = duel ? 'duel' : 'copilot' %}
{% set waiting = duel ? 'status.rival_waiting' : 'status.copilot_waiting' %}
{% set connected = duel ? 'status.rival_connected' : 'status.copilot_connected' %}
{% set unnamed = duel ? 'status.rival_connected_unnamed' : 'status.copilot_connected_unnamed' %}
{% set mode = game.mode.value %}
{% block body %}
    <main class="lobby"
          data-controller="agent-status"
          data-agent-status-url-value="{{ path('game_agent', {id: game.id}) }}"
          data-agent-status-connected-value="{{ game.agentConnected ? 'true' : 'false' }}"
          data-agent-status-connected-label-value="{{ connected|trans }}"
          data-agent-status-unnamed-label-value="{{ unnamed|trans }}">
        <h1>{{ (duel ? 'heading.lobby_duel' : 'heading.lobby')|trans }}</h1>
        <section class="lobby-role">
            {{ include('game/_mode_sketch.html.twig') }}
            <div>
                <h2>{{ ('lobby.' ~ mode ~ '_does')|trans }}</h2>
                <ul>
                    {% for line in 1..4 %}<li>{{ ('lobby.' ~ mode ~ '_does_' ~ line)|trans }}</li>{% endfor %}
                </ul>
            </div>
        </section>

        <h2>{{ 'lobby.connect'|trans }}</h2>
        <p class="lobby-vision">{{ 'lobby.vision'|trans }}</p>

        <ol class="lobby-steps">
            <li>
                {{ 'lobby.step_add'|trans }}
                <div class="command" data-controller="copy" data-copy-copied-label-value="{{ 'status.copied'|trans }}"><pre><code data-copy-target="source">claude mcp add --scope user --transport http draw-it {{ url('_mcp_endpoint_default') }}</code></pre><button type="button" class="copy" data-copy-target="button" data-action="copy#copy" aria-label="{{ 'action.copy'|trans }}" title="{{ 'action.copy'|trans }}"><svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><g fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"><rect class="copy-sheets" x="8" y="8" width="12" height="12" rx="2"/><path class="copy-sheets" d="M16 8V5a1 1 0 0 0-1-1H5a1 1 0 0 0-1 1v10a1 1 0 0 0 1 1h3"/><path class="copy-check" d="M5 12l5 5L20 7"/></g></svg></button></div>
            </li>
            <li>
                {{ 'lobby.step_prompt'|trans }}
                <div class="command" data-controller="copy" data-copy-copied-label-value="{{ 'status.copied'|trans }}"><pre><code data-copy-target="source">/mcp__draw-it__{{ prompt }}</code></pre><button type="button" class="copy" data-copy-target="button" data-action="copy#copy" aria-label="{{ 'action.copy'|trans }}" title="{{ 'action.copy'|trans }}"><svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><g fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"><rect class="copy-sheets" x="8" y="8" width="12" height="12" rx="2"/><path class="copy-sheets" d="M16 8V5a1 1 0 0 0-1-1H5a1 1 0 0 0-1 1v10a1 1 0 0 0 1 1h3"/><path class="copy-check" d="M5 12l5 5L20 7"/></g></svg></button></div>
            </li>
        </ol>
        <p class="lobby-other">{{ 'lobby.other_clients'|trans({'%url%': url('_mcp_endpoint_default'), '%prompt%': prompt}) }}</p>

        <p class="agent-status {{ game.agentConnected ? 'connected' }}" role="status" data-agent-status-target="status">
            {% if not game.agentConnected %}{{ waiting|trans }}{% elseif game.agentDisplayName %}{{ connected|trans({'%name%': game.agentDisplayName}) }}{% else %}{{ unnamed|trans }}{% endif %}
        </p>

        <form method="post" action="{{ path('game_next_round', {id: game.id}) }}" {{ include('game/_deal.html.twig', {number: 1}) }}>
            <button type="submit">{{ 'action.start_game'|trans }}</button>
        </form>
        <form method="post" action="{{ path('game_leave', {id: game.id}) }}" class="leave"><button type="submit" class="link">{{ 'action.leave_game'|trans }}</button></form>
    </main>
{% endblock %}
