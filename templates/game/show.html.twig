{% extends 'base.html.twig' %}

{% block title %}Draw It If You Can{% endblock %}

{% block body %}
    <main class="game"
          data-controller="canvas"
          data-canvas-strokes-url-value="{{ path('game_strokes', {id: game.id}) }}"
          data-canvas-add-url-value="{{ path('game_stroke_add', {id: game.id}) }}"
          data-canvas-undo-url-value="{{ path('game_stroke_undo', {id: game.id}) }}">
        <canvas class="canvas" width="1000" height="1000" data-canvas-target="canvas"></canvas>
        <div class="toolbar">
            <button type="button" data-action="canvas#undo">Undo</button>
            <a href="{{ path('home') }}">New game</a>
        </div>
    </main>
{% endblock %}
