{% extends 'base.html.twig' %}

{% block body %}
    <main class="game-over">
        <h1>{{ 'heading.game_over'|trans }}</h1>
        {% if game.duel %}
            {% set rival = game.agentDisplayName ?? 'label.rival_unknown'|trans %}
            {% set separator = 'label.thousands_separator'|trans %}
            {% set rival_name = rival|slice(0, 1)|upper ~ rival|slice(1) %}
            {% set outcome = total > rival_total ? 'won' : (total < rival_total ? 'lost' : 'tie') %}
            <section class="duel-banner duel-{{ outcome }}{{ outcome == 'won' ? ' side-team' : (outcome == 'lost' ? ' side-rival') }}" aria-live="polite">
                <p class="duel-banner-title">
                    {% if outcome == 'won' %}{{ 'result.duel_won'|trans }}
                    {% elseif outcome == 'lost' %}{{ 'result.duel_lost'|trans({'%name%': rival_name}) }}
                    {% else %}{{ 'result.duel_tie'|trans }}{% endif %}
                </p>
                <p class="duel-banner-score">{{ 'result.duel_score'|trans({'%you%': total|number_format(0, '', separator), '%rival%': rival_total|number_format(0, '', separator)}) }}</p>
            </section>
        {% else %}
            <p class="final-score">{{ 'result.final_score'|trans({'%points%': '<strong>' ~ total ~ '</strong>'})|raw }}</p>
        {% endif %}
        <table>
            <thead>
                <tr>
                    <th scope="col">{{ 'column.round'|trans }}</th>
                    <th scope="col">{{ 'column.drawer'|trans }}</th>
                    <th scope="col">{{ 'label.theme'|trans }}</th>
                    <th scope="col">{{ 'column.word'|trans }}</th>
                    <th scope="col">{{ 'column.found_in'|trans }}</th>
                    {% if game.duel %}<th scope="col">{{ 'column.found_by'|trans }}</th>{% endif %}
                    <th scope="col">{{ 'column.points'|trans }}</th>
                </tr>
            </thead>
            <tbody>
                {% for row in rounds %}
                    <tr>
                        <td>{{ row.round.number }}</td>
                        <td>{{ ('drawer.' ~ row.round.drawnBy.value)|trans }}</td>
                        <td>{{ row.round.theme|trans }}</td>
                        <td>{{ row.round.targetPhrase }}</td>
                        <td>{{ row.round.found ? (row.round.foundAfterMs / 1000)|number_format(1, 'label.decimal_separator'|trans) ~ ' s' : 'result.not_found'|trans }}</td>
                        {% if game.duel %}
                            <td>{% if row.round.foundByRival %}<span class="side-rival">{{ rival }}</span>{% elseif row.round.found %}<span class="side-team">{{ ('found_by.' ~ row.round.foundBy.value)|trans }}</span>{% endif %}</td>
                        {% endif %}
                        <td>{{ row.points }}</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
        <a class="button" href="{{ path('home', {_locale: app.locale}) }}">{{ 'action.new_game'|trans }}</a>
    </main>
{% endblock %}
