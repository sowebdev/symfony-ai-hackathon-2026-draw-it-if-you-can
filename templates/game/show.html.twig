{% extends 'base.html.twig' %}

{% block body %}
    <main class="game-over">
        <h1>{{ 'heading.game_over'|trans }}</h1>
        <p class="final-score">{{ 'result.final_score'|trans({'%points%': '<strong>' ~ total ~ '</strong>'})|raw }}</p>
        <table>
            <thead>
                <tr>
                    <th scope="col">{{ 'column.round'|trans }}</th>
                    <th scope="col">{{ 'column.drawer'|trans }}</th>
                    <th scope="col">{{ 'column.word'|trans }}</th>
                    <th scope="col">{{ 'column.found_in'|trans }}</th>
                    <th scope="col">{{ 'column.points'|trans }}</th>
                </tr>
            </thead>
            <tbody>
                {% for row in rounds %}
                    <tr>
                        <td>{{ row.round.number }}</td>
                        <td>{{ ('drawer.' ~ row.round.drawnBy.value)|trans }}</td>
                        <td>{{ row.round.targetWord }}</td>
                        <td>{{ row.round.found ? (row.round.foundAfterMs / 1000)|number_format(1, 'label.decimal_separator'|trans) ~ ' s' : 'result.not_found'|trans }}</td>
                        <td>{{ row.points }}</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
        <a class="button" href="{{ path('home', {_locale: app.locale}) }}">{{ 'action.new_game'|trans }}</a>
    </main>
{% endblock %}
