{# The choice of a model: a card per family (its newest model, the cheapest marked), the other models and the field to type a name folded away. #}
{# `field` is the radio group (absent when the list is empty), `typed` the text field, `layout` what the controller arranged. #}
{% set radios = {} %}
{% if field %}
    {% for radio in field %}
        {% set radios = radios|merge({(radio.vars.value): radio}) %}
    {% endfor %}
{% endif %}

{% macro option(radio, cheapest, unknown) %}
    <label class="model-option{{ cheapest ? ' cheapest' : '' }}">
        {{ form_widget(radio) }}
        <code>{{ radio.vars.value }}</code>
        {% if cheapest %}<em class="cheapest-mark">{{ 'models.cheapest'|trans }}</em>{% endif %}
        {% if unknown %}<em class="unknown-mark">{{ 'models.unknown_capabilities'|trans }}</em>{% endif %}
    </label>
{% endmacro %}

{% if field and layout.cards %}
    <div class="model-cards">
        {% for name in layout.cards %}
            {{ _self.option(radios[name], name == layout.cheapest, name in layout.unknown) }}
        {% endfor %}
    </div>
{% endif %}

{% macro typed_field(typed, field) %}
    <div class="field">
        {{ form_label(typed, field ? 'models.type_name' : 'models.model_name') }}
        {{ form_widget(typed) }}
        {{ form_errors(typed) }}
    </div>
{% endmacro %}

{% if not field %}
    {# No list to pick from, or none that can be read: the text field is the only way, shown at once. #}
    {{ _self.typed_field(typed, field) }}
{% else %}
    {# Older versions and unknown families, and the typed name: folded, open when a typed name or one of those models is the choice. #}
    {% set chosen = field.vars.data %}
    {% set unfolded = layout.cards is empty and not layout.long %}
    {% set open = typed.vars.value is not empty or typed.vars.errors|length or (chosen and chosen in layout.others and not unfolded) %}
    {% if unfolded and layout.others %}
        <div class="model-list">
            {% for name in layout.others %}
                {{ _self.option(radios[name], false, name in layout.unknown) }}
            {% endfor %}
        </div>
    {% endif %}
    <details class="long-list"{% if open %} open{% endif %}>
        <summary>{{ layout.long ? 'models.pick_from'|trans({'%count%': layout.count}) : 'models.all_models'|trans }}</summary>
        {% if layout.others and not unfolded %}
            <div class="model-list">
                {% for name in layout.others %}
                    {{ _self.option(radios[name], false, name in layout.unknown) }}
                {% endfor %}
            </div>
        {% endif %}
        {{ _self.typed_field(typed, field) }}
    </details>
    {{ form_errors(field) }}
{% endif %}
