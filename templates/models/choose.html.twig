{% extends 'base.html.twig' %}

{% block title %}{{ 'models.title'|trans }} · Draw It If You Can{% endblock %}

{# Step 2: the model, from the list of the provider or typed, and optionally another one to guess. #}
{% block loading %}{{ include('_loading.html.twig', {loading_title: 'status.checking_models'}) }}{% endblock %}

{% block body %}
    <main class="models">
        <a class="models-home" href="{{ path('home') }}">← {{ 'action.back_home'|trans }}</a>
        {{ include('models/_steps.html.twig', {step: 2}) }}
        <h1>{{ 'models.choose_title'|trans }}</h1>
        <p class="models-intro">{{ 'models.using'|trans({'%provider%': ('provider.' ~ draft.provider.value)|trans}) }}{% if draft.provider.hasAddress %} <code>{{ draft.address }}</code>{% endif %}</p>

        {% if problem %}
            <div class="models-problem" role="alert">
                <p><strong>{{ 'models.list_unreadable'|trans }}</strong> {{ problem }}</p>
                <p>{{ 'models.type_instead'|trans }} <a href="{{ path('models_choose', {fresh: 1}) }}">{{ 'action.try_again'|trans }}</a></p>
            </div>
        {% endif %}

        {# The wait for the models (several seconds) shows the loading screen of the game. #}
        {{ form_start(form, {attr: {class: 'models-form', novalidate: 'novalidate', 'data-controller': 'loading', 'data-action': 'loading#show'}}) }}
            <fieldset class="role-models">
                <legend>{{ 'models.the_model'|trans }}</legend>
                <p class="hint">{{ 'models.the_model_hint'|trans }}</p>
                {{ include('models/_role_choice.html.twig', {field: form.drawerChoice is defined ? form.drawerChoice : null, typed: form.drawerName, layout: layouts.drawer}) }}
            </fieldset>

            {# A second choice, shown by CSS only (:has(:checked)): unchecked, the guesser is the model above. #}
            <div class="other-guesser field switch">
                <label class="switch-label">
                    {{ form_widget(form.otherGuesser) }}
                    <span>{{ 'models.other_guesser'|trans }}</span>
                </label>
                {{ form_errors(form.otherGuesser) }}
            </div>
            <fieldset class="role-models guesser-models">
                <legend>{{ 'role.guesser'|trans }}</legend>
                <p class="hint">{{ 'models.needs_guesser'|trans }}</p>
                {{ include('models/_role_choice.html.twig', {field: form.guesserChoice is defined ? form.guesserChoice : null, typed: form.guesserName, layout: layouts.guesser}) }}
            </fieldset>

            {% if not capabilities_known and (layouts.drawer.count > 0) %}
                <p class="hint">{{ 'models.capabilities_unknown'|trans }}</p>
            {% elseif layouts.drawer.count == 0 %}
                <p class="hint">{{ 'models.typed_unknown'|trans }}</p>
            {% endif %}

            {% if form.reasoningOff is defined %}
                <div class="field switch">
                    <label class="switch-label">
                        {{ form_widget(form.reasoningOff) }}
                        <span>{{ 'models.reasoning_off'|trans }}</span>
                    </label>
                    <small class="hint">{{ 'models.reasoning_hint'|trans }}</small>
                    {{ form_errors(form.reasoningOff) }}
                </div>
            {% endif %}

            <div class="models-actions">
                <a href="{{ path('models_provider', {back: 1}) }}">← {{ 'action.back'|trans }}</a>
                {{ form_widget(form.check) }}
            </div>
            {{ form_rest(form) }}
        {{ form_end(form, {render_rest: false}) }}
    </main>
{% endblock %}
