{% extends 'base.html.twig' %}

{% block title %}{{ ('models.question_model_' ~ role.value)|trans }} · Draw It If You Can{% endblock %}

{# Question 3 of a role: its model, from the list of the provider or typed. "Check and play" goes to the check. #}
{% block loading %}{{ include('_loading.html.twig', {loading_title: 'status.checking_models'}) }}{% endblock %}

{% block body %}
    <main class="models">
        <a class="models-home" href="{{ path(provider.hasAddress or not provider.needsKey ? 'models_access' : 'models_provider', {role: role.value}) }}">← {{ 'action.back'|trans }}</a>
        <ul class="role-lines">
            {% for other in others %}
                {{ include('models/_line.html.twig', {role: other.role, view: other.view}) }}
            {% endfor %}
        </ul>
        <h1>{{ ('models.question_model_' ~ role.value)|trans }}</h1>
        <p class="models-intro hint">
            {{ provider.hasAddress ? 'models.at_own'|trans : 'models.at_provider'|trans({'%provider%': ('provider.' ~ provider.value)|trans}) }}{% if provider.hasAddress %} <code>{{ address }}</code>{% endif %}
            · <a href="{{ path('models_access', {role: role.value}) }}">{{ 'models.change_key'|trans }}</a>
        </p>

        {% if problem %}
            <div class="models-problem" role="alert">
                <p><strong>{{ 'models.list_unreadable'|trans }}</strong> {{ problem }}</p>
                <p>{{ 'models.type_instead'|trans }} <a href="{{ path('models_model', {role: role.value, fresh: 1}) }}">{{ 'action.try_again'|trans }}</a></p>
            </div>
        {% endif %}

        {# The wait for the models (several seconds) shows the loading screen of the game. #}
        {{ form_start(form, {attr: {class: 'models-form', novalidate: 'novalidate', 'data-controller': 'loading', 'data-action': 'loading#show'}}) }}
            <fieldset class="role-models">
                <legend class="sr-only">{{ ('models.question_model_' ~ role.value)|trans }}</legend>
                {{ include('models/_role_choice.html.twig', {field: form.choice is defined ? form.choice : null, typed: form.name, layout: layout}) }}
            </fieldset>

            {% if not capabilities_known and layout.count > 0 %}
                <p class="hint">{{ 'models.capabilities_unknown'|trans }}</p>
            {% elseif layout.count == 0 %}
                <p class="hint">{{ 'models.typed_unknown'|trans }}</p>
            {% endif %}

            {% if form.reasoningOff is defined %}
                <details class="long-list"{% if form.reasoningOff.vars.checked %} open{% endif %}>
                    <summary>{{ 'models.advanced'|trans }}</summary>
                    <div class="field switch">
                        <label class="switch-label">
                            {{ form_widget(form.reasoningOff) }}
                            <span>{{ 'models.reasoning_off'|trans }}</span>
                        </label>
                        <small class="hint">{{ 'models.reasoning_hint'|trans }}</small>
                        {{ form_errors(form.reasoningOff) }}
                    </div>
                </details>
            {% endif %}

            <div class="models-actions">
                {{ form_widget(form.check) }}
            </div>
            {% if form.another is defined %}
                <p class="follows-line">
                    <span>{{ 'models.follows_guesser'|trans }}</span>
                    {{ form_widget(form.another, {attr: {class: 'link', 'data-plain': 'data-plain'}}) }}
                </p>
            {% endif %}
            {{ form_rest(form) }}
        {{ form_end(form, {render_rest: false}) }}
    </main>
{% endblock %}
