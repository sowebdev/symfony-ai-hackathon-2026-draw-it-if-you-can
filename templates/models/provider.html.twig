{% extends 'base.html.twig' %}

{% block title %}{{ ('models.question_provider_' ~ role.value)|trans }} · Draw It If You Can{% endblock %}

{# Question 1 of a role: which provider. Nothing else: the next question comes with "Continue". #}
{% block body %}
    <main class="models">
        <a class="models-home" href="{{ back }}">← {{ 'action.back'|trans }}</a>
        <ul class="role-lines">
            {% for other in others %}
                {{ include('models/_line.html.twig', {role: other.role, view: other.view}) }}
            {% endfor %}
        </ul>
        <h1>{{ ('models.question_provider_' ~ role.value)|trans }}</h1>

        {{ form_start(form, {attr: {class: 'models-form', novalidate: 'novalidate'}}) }}
            <fieldset class="providers">
                <legend class="sr-only">{{ ('models.question_provider_' ~ role.value)|trans }}</legend>
                <div class="provider-cards">
                    {% for choice in form.provider %}
                        <label class="provider-card provider-{{ choice.vars.value }}">
                            {{ form_widget(choice) }}
                            <strong>{{ choice.vars.label|trans }}</strong>
                            {% if choice.vars.value in saved %}<em class="saved-mark">{{ 'models.key_saved_tag'|trans }}</em>{% endif %}
                        </label>
                    {% endfor %}
                </div>
                {{ form_errors(form.provider) }}
            </fieldset>

            <div class="models-actions">
                {{ form_widget(form.continue) }}
            </div>
            {{ form_rest(form) }}
        {{ form_end(form, {render_rest: false}) }}

        {% if same %}
            {{ form_start(same, {attr: {class: 'same-as-drawer'}}) }}
                {{ form_widget(same.same, {label: ('models.same_as_' ~ role.fallback.value), attr: {class: 'link'}}) }}
            {{ form_end(same) }}
        {% endif %}
    </main>
{% endblock %}
