{% extends 'base.html.twig' %}

{% block body %}
    <main class="round"
          data-controller="canvas guesses round-timer{{ round.game.duel ? ' agent' }}"
          {{ include('round/_timer.html.twig') }}
          data-canvas-elapsed-ms-value="{{ round.elapsedMs }}"
          data-canvas-strokes-url-value="{{ path('round_strokes', {id: round.id}) }}"
          data-canvas-add-url-value="{{ path('round_stroke_add', {id: round.id}) }}"
          data-canvas-undo-url-value="{{ path('round_stroke_undo', {id: round.id}) }}"
          data-canvas-locked-value="{{ round.over ? 'true' : 'false' }}"
          data-guesses-stream-url-value="{{ path('round_guesses', {id: round.id}) }}"
          data-guesses-accept-url-value="{{ path('round_guess_accept', {id: round.id, guessId: 0}) }}"
          data-guesses-yes-label-value="{{ 'action.accept_guess'|trans }}"
          data-guesses-over-value="{{ round.over ? 'true' : 'false' }}"
          {% if round.game.duel %}{{ include('round/_agent.html.twig') }}{% endif %}
          data-action="guesses:found->canvas#lock guesses:found->round-timer#finish round-timer:up->canvas#lock round-timer:up->guesses#stop agent:found->canvas#lock agent:found->guesses#stop agent:found->round-timer#finish">
        {{ include('round/_scoreboard.html.twig') }}
        <p class="target">{{ 'instruction.draw'|trans }} <strong>{{ round.targetWord }}</strong> <span class="target-theme">· {{ round.theme.icon }} {{ round.theme|trans }}</span></p>

        <div class="board">
            <div class="stage">
                <canvas class="canvas" width="1000" height="1000" data-canvas-target="canvas"></canvas>
                {% if round.over %}{{ include('round/_end.html.twig') }}{% endif %}
            </div>

            <section class="side guesses" aria-live="polite">
                {{ include('round/_gauge.html.twig') }}
                <h2>{{ (round.game.duel ? 'heading.your_ai_guesses' : 'heading.ai_guesses')|trans }}</h2>
                <ol data-guesses-target="list">
                    {% for guess in guesses %}
                        <li data-guess-id="{{ guess.id }}" class="{{ guess.accepted ? 'accepted' }}">
                            <span>{{ guess.word }}</span>
                            {% if not round.over %}<button type="button" data-action="guesses#accept">{{ 'action.accept_guess'|trans }}</button>{% endif %}
                        </li>
                    {% endfor %}
                </ol>
                <p class="result" data-guesses-target="result" hidden>
                    {{ 'result.found_in'|trans({'%seconds%': '<strong data-guesses-target="time"></strong>'})|raw }}
                </p>

                {% if round.game.duel %}
                    <div class="rival-answers">
                        <h2>{{ 'heading.rival_answers'|trans({'%name%': round.game.agentDisplayName ?? 'label.rival_unknown'|trans}) }}</h2>
                        <ol data-agent-target="answers">
                            {% for answer in rival_answers %}
                                <li data-answer-id="{{ answer.id }}" class="{{ answer.accepted ? 'accepted' }}">{{ answer.word }}</li>
                            {% endfor %}
                        </ol>
                    </div>
                {% endif %}

                <div class="toolbar">
                    {% if not round.over %}<button type="button" data-action="canvas#undo" data-canvas-target="undo">{{ 'action.undo'|trans }}</button>{% endif %}
                    <form method="post" action="{{ path('game_leave', {id: round.game.id}) }}" class="leave"><button type="submit" class="link">{{ 'action.new_game'|trans }}</button></form>
                </div>
            </section>
        </div>
    </main>
{% endblock %}
