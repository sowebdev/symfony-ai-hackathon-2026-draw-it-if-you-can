<?xml version="1.0" encoding="utf-8"?>
<!-- Keys describe their purpose, not where they are shown (Symfony best practices). Same keys in every language: tests/Unit/TranslationsTest.php -->
<xliff xmlns="urn:oasis:names:tc:xliff:document:1.2" version="1.2">
    <file source-language="en" target-language="fr" datatype="plaintext" original="file.ext">
        <body>
            <trans-unit id="tagline" resname="tagline">
                <source>tagline</source>
                <target>Dessine pour l'IA, ou devine ses dessins.</target>
                <note>Under the title of the home page</note>
            </trans-unit>
            <trans-unit id="label.language" resname="label.language">
                <source>label.language</source>
                <target>Langue</target>
                <note>Name of the language switcher, for screen readers</note>
            </trans-unit>
            <trans-unit id="label.theme" resname="label.theme">
                <source>label.theme</source>
                <target>Thème</target>
                <note>Field of the new game form</note>
            </trans-unit>
            <trans-unit id="action.new_game" resname="action.new_game">
                <source>action.new_game</source>
                <target>Nouvelle partie</target>
                <note>Button and link that start a new game</note>
            </trans-unit>
            <trans-unit id="action.undo" resname="action.undo">
                <source>action.undo</source>
                <target>Annuler</target>
                <note>Removes the last stroke</note>
            </trans-unit>
            <trans-unit id="action.accept_guess" resname="action.accept_guess">
                <source>action.accept_guess</source>
                <target>Oui !</target>
                <note>Next to a word of the AI: the player says it is right</note>
            </trans-unit>
            <trans-unit id="instruction.draw" resname="instruction.draw">
                <source>instruction.draw</source>
                <target>À dessiner :</target>
                <note>Before the word the player must draw</note>
            </trans-unit>
            <trans-unit id="heading.ai_guesses" resname="heading.ai_guesses">
                <source>heading.ai_guesses</source>
                <target>L'IA propose…</target>
                <note>Above the words the AI calls out</note>
            </trans-unit>
            <trans-unit id="result.found_in" resname="result.found_in">
                <source>result.found_in</source>
                <target>Trouvé en %seconds% s</target>
                <note>When the AI found the word; %seconds% is a number in an HTML element</note>
            </trans-unit>
            <trans-unit id="error.no_word" resname="error.no_word">
                <source>error.no_word</source>
                <target>L'IA n'a pas pu choisir de mot. Le modèle tourne-t-il ? « make check » dit ce qui ne va pas.</target>
                <note>The model gave no word to draw</note>
            </trans-unit>
            <trans-unit id="theme.animals" resname="theme.animals">
                <source>theme.animals</source>
                <target>Animaux</target>
                <note>Name of a theme</note>
            </trans-unit>
            <trans-unit id="theme.food" resname="theme.food">
                <source>theme.food</source>
                <target>Cuisine</target>
                <note>Name of a theme</note>
            </trans-unit>
            <trans-unit id="theme.everyday-objects" resname="theme.everyday-objects">
                <source>theme.everyday-objects</source>
                <target>Objets du quotidien</target>
                <note>Name of a theme</note>
            </trans-unit>
            <trans-unit id="theme.developer" resname="theme.developer">
                <source>theme.developer</source>
                <target>Vie de développeur</target>
                <note>Name of a theme</note>
            </trans-unit>
            <trans-unit id="action.player_draws" resname="action.player_draws">
                <source>action.player_draws</source>
                <target>Je dessine</target>
                <note>Starts a game where the player draws and the AI guesses</note>
            </trans-unit>
            <trans-unit id="action.ai_draws" resname="action.ai_draws">
                <source>action.ai_draws</source>
                <target>L'IA dessine</target>
                <note>Starts a game where the AI draws and the player guesses</note>
            </trans-unit>
            <trans-unit id="instruction.guess" resname="instruction.guess">
                <source>instruction.guess</source>
                <target>Que dessine l'IA ?</target>
                <note>Above the drawing of the AI</note>
            </trans-unit>
            <trans-unit id="label.answer" resname="label.answer">
                <source>label.answer</source>
                <target>Ta réponse</target>
                <note>Field where the player types a guess</note>
            </trans-unit>
            <trans-unit id="action.answer" resname="action.answer">
                <source>action.answer</source>
                <target>Proposer</target>
                <note>Sends the guess of the player</note>
            </trans-unit>
            <trans-unit id="heading.player_guesses" resname="heading.player_guesses">
                <source>heading.player_guesses</source>
                <target>Tes propositions</target>
                <note>Above the words the player tried</note>
            </trans-unit>
            <trans-unit id="action.give_up" resname="action.give_up">
                <source>action.give_up</source>
                <target>Je donne ma langue au chat</target>
                <note>The player gives up and sees the word</note>
            </trans-unit>
            <trans-unit id="result.word_was" resname="result.word_was">
                <source>result.word_was</source>
                <target>Le mot était %word%</target>
                <note>After giving up; %word% is the word in an HTML element</note>
            </trans-unit>
            <trans-unit id="status.ai_drawing" resname="status.ai_drawing">
                <source>status.ai_drawing</source>
                <target>L'IA dessine…</target>
                <note>While the AI draws</note>
            </trans-unit>
            <trans-unit id="status.ai_finished" resname="status.ai_finished">
                <source>status.ai_finished</source>
                <target>L'IA a fini son dessin.</target>
                <note>When the AI has drawn its last stroke</note>
            </trans-unit>
            <trans-unit id="error.ai_drawing" resname="error.ai_drawing">
                <source>error.ai_drawing</source>
                <target>L'IA n'a pas pu dessiner. « make check » dit ce qui ne va pas.</target>
                <note>The model could not draw</note>
            </trans-unit>
            <trans-unit id="label.round" resname="label.round">
                <source>label.round</source>
                <target>Manche %number% / %count%</target>
                <note>Number of the round being played</note>
            </trans-unit>
            <trans-unit id="label.team_score" resname="label.team_score">
                <source>label.team_score</source>
                <target>Score d'équipe</target>
                <note>Points of the player and the AI together</note>
            </trans-unit>
            <trans-unit id="label.time_left" resname="label.time_left">
                <source>label.time_left</source>
                <target>Temps restant</target>
                <note>Before the seconds left in the round</note>
            </trans-unit>
            <trans-unit id="label.points_at_stake" resname="label.points_at_stake">
                <source>label.points_at_stake</source>
                <target>Ce mot vaut</target>
                <note>Before the points the word is worth now, above the gauge</note>
            </trans-unit>
            <trans-unit id="label.who_starts" resname="label.who_starts">
                <source>label.who_starts</source>
                <target>Qui dessine en premier ?</target>
                <note>Above the buttons that start a game</note>
            </trans-unit>
            <trans-unit id="heading.round_found" resname="heading.round_found">
                <source>heading.round_found</source>
                <target>Trouvé !</target>
                <note>End of a round: the word was found</note>
            </trans-unit>
            <trans-unit id="heading.round_time_up" resname="heading.round_time_up">
                <source>heading.round_time_up</source>
                <target>Temps écoulé !</target>
                <note>End of a round: nobody found the word in time</note>
            </trans-unit>
            <trans-unit id="heading.round_given_up" resname="heading.round_given_up">
                <source>heading.round_given_up</source>
                <target>Pas cette fois</target>
                <note>End of a round: the player gave up</note>
            </trans-unit>
            <trans-unit id="result.points_won" resname="result.points_won">
                <source>result.points_won</source>
                <target>+%points% points</target>
                <note>Points won in the round</note>
            </trans-unit>
            <trans-unit id="action.next_round_player" resname="action.next_round_player">
                <source>action.next_round_player</source>
                <target>Manche suivante : à toi de dessiner</target>
                <note>Starts the next round, drawn by the player</note>
            </trans-unit>
            <trans-unit id="action.next_round_ai" resname="action.next_round_ai">
                <source>action.next_round_ai</source>
                <target>Manche suivante : l'IA dessine</target>
                <note>Starts the next round, drawn by the AI</note>
            </trans-unit>
            <trans-unit id="action.final_score" resname="action.final_score">
                <source>action.final_score</source>
                <target>Voir le score final</target>
                <note>After the last round</note>
            </trans-unit>
            <trans-unit id="action.retry" resname="action.retry">
                <source>action.retry</source>
                <target>Réessayer</target>
                <note>Asks again for a word to draw</note>
            </trans-unit>
            <trans-unit id="heading.game_over" resname="heading.game_over">
                <source>heading.game_over</source>
                <target>Partie terminée</target>
                <note>Title of the final score page</note>
            </trans-unit>
            <trans-unit id="result.final_score" resname="result.final_score">
                <source>result.final_score</source>
                <target>Score d'équipe : %points% points</target>
                <note>Final score; %points% is a number in an HTML element</note>
            </trans-unit>
            <trans-unit id="result.not_found" resname="result.not_found">
                <source>result.not_found</source>
                <target>pas trouvé</target>
                <note>In the table of the final score, for a word nobody found</note>
            </trans-unit>
            <trans-unit id="column.round" resname="column.round">
                <source>column.round</source>
                <target>Manche</target>
                <note>Column of the final score table</note>
            </trans-unit>
            <trans-unit id="column.drawer" resname="column.drawer">
                <source>column.drawer</source>
                <target>Dessin de</target>
                <note>Column of the final score table</note>
            </trans-unit>
            <trans-unit id="column.word" resname="column.word">
                <source>column.word</source>
                <target>Mot</target>
                <note>Column of the final score table</note>
            </trans-unit>
            <trans-unit id="column.found_in" resname="column.found_in">
                <source>column.found_in</source>
                <target>Trouvé en</target>
                <note>Column of the final score table</note>
            </trans-unit>
            <trans-unit id="column.points" resname="column.points">
                <source>column.points</source>
                <target>Points</target>
                <note>Column of the final score table</note>
            </trans-unit>
            <trans-unit id="drawer.player" resname="drawer.player">
                <source>drawer.player</source>
                <target>toi</target>
                <note>Who drew a round: the player</note>
            </trans-unit>
            <trans-unit id="drawer.ai" resname="drawer.ai">
                <source>drawer.ai</source>
                <target>l'IA</target>
                <note>Who drew a round: the AI</note>
            </trans-unit>
            <trans-unit id="label.decimal_separator" resname="label.decimal_separator">
                <source>label.decimal_separator</source>
                <target>,</target>
                <note>Between the units and the tenths of a number of seconds</note>
            </trans-unit>
            <trans-unit id="heading.copilot_hints" resname="heading.copilot_hints">
                <source>heading.copilot_hints</source>
                <target>Ton copilote souffle…</target>
                <note>Above the words an agent connected over MCP suggests to the player</note>
            </trans-unit>
            <trans-unit id="label.with_copilot" resname="label.with_copilot">
                <source>label.with_copilot</source>
                <target>Avec un copilote : un agent branché par MCP m'aide à deviner</target>
                <note>Checkbox on the home page</note>
            </trans-unit>
            <trans-unit id="label.copilot" resname="label.copilot">
                <source>label.copilot</source>
                <target>Copilote :</target>
                <note>Before the name of the copilot, in the bar of a round</note>
            </trans-unit>
            <trans-unit id="heading.lobby" resname="heading.lobby">
                <source>heading.lobby</source>
                <target>Branche ton copilote</target>
                <note>Title of the lobby of a game with a copilot</note>
            </trans-unit>
            <trans-unit id="lobby.intro" resname="lobby.intro">
                <source>lobby.intro</source>
                <target>Quand l'IA dessine, ton copilote regarde le dessin et te souffle des mots dans la marge. Un clic sur un mot, et c'est ta réponse.</target>
                <note>First paragraph of the lobby</note>
            </trans-unit>
            <trans-unit id="lobby.step_add" resname="lobby.step_add">
                <source>lobby.step_add</source>
                <target>Avec Claude Code, une seule fois, dans le dossier du jeu :</target>
                <note>First step of the lobby, before a command</note>
            </trans-unit>
            <trans-unit id="lobby.step_prompt" resname="lobby.step_prompt">
                <source>lobby.step_prompt</source>
                <target>Ouvre Claude Code dans ce dossier, puis lance le prompt du copilote :</target>
                <note>Second step of the lobby, before a command</note>
            </trans-unit>
            <trans-unit id="lobby.other_clients" resname="lobby.other_clients">
                <source>lobby.other_clients</source>
                <target>Un autre client MCP : branche-le sur %url%, puis demande-lui le prompt copilot.</target>
                <note>Under the steps of the lobby</note>
            </trans-unit>
            <trans-unit id="status.copilot_waiting" resname="status.copilot_waiting">
                <source>status.copilot_waiting</source>
                <target>En attente de ton copilote…</target>
                <note>In the lobby, until the agent calls the game</note>
            </trans-unit>
            <trans-unit id="status.copilot_connected" resname="status.copilot_connected">
                <source>status.copilot_connected</source>
                <target>Copilote connecté : %name%</target>
                <note>In the lobby, once the agent called the game; %name% is the name of its MCP client</note>
            </trans-unit>
            <trans-unit id="status.copilot_absent" resname="status.copilot_absent">
                <source>status.copilot_absent</source>
                <target>pas encore connecté</target>
                <note>In the bar of a round, when the copilot never called the game</note>
            </trans-unit>
            <trans-unit id="action.start_game" resname="action.start_game">
                <source>action.start_game</source>
                <target>Commencer la partie</target>
                <note>Leaves the lobby: the first round starts</note>
            </trans-unit>
            <trans-unit id="role.drawer" resname="role.drawer">
                <source>role.drawer</source>
                <target>Le dessinateur</target>
                <note>Name of the role of the model that draws, on the home page</note>
            </trans-unit>
            <trans-unit id="role.guesser" resname="role.guesser">
                <source>role.guesser</source>
                <target>Le devineur</target>
                <note>Name of the role of the model that picks the word and guesses, on the home page</note>
            </trans-unit>
            <trans-unit id="status.checking_models" resname="status.checking_models">
                <source>status.checking_models</source>
                <target>Vérification des modèles…</target>
                <note>Home page, while the models are tried</note>
            </trans-unit>
            <trans-unit id="help.models" resname="help.models">
                <source>help.models</source>
                <target>Un modèle ne répond pas comme il faut. Règle AI_DRAWER_* et AI_GUESSER_* dans .env.local (voir le README), puis réessaie. « make check » dit la même chose dans un terminal.</target>
                <note>Home page, when a model fails its check</note>
            </trans-unit>
            <trans-unit id="action.check_again" resname="action.check_again">
                <source>action.check_again</source>
                <target>Vérifier à nouveau</target>
                <note>Home page: tries the models again</note>
            </trans-unit>
            <trans-unit id="status.picking_word" resname="status.picking_word">
                <source>status.picking_word</source>
                <target>L'IA choisit un mot…</target>
                <note>Loading screen, while the model picks the word of a round</note>
            </trans-unit>
            <trans-unit id="status.picking_word_note" resname="status.picking_word_note">
                <source>status.picking_word_note</source>
                <target>Avec un modèle local, ça peut prendre quelques secondes.</target>
                <note>Loading screen, under the title</note>
            </trans-unit>
        </body>
    </file>
</xliff>
