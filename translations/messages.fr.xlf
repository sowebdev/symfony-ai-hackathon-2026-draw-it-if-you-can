            </trans-unit>
            <trans-unit id="status.checking_models" resname="status.checking_models">
                <source>status.checking_models</source>
                <target>Vérification des modèles…</target>
                <note>Home page, while the models are tried</note>
            </trans-unit>
            <trans-unit id="status.models_slow" resname="status.models_slow">
                <source>status.models_slow</source>
